      "source": [
        "# **ETTh1: Multi- to Univariate Squence-to-Squence Forecasting with LSTMs**\n",
        "---"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 124,
      "id": "e7de6f08",
      "metadata": {
        "id": "e7de6f08"
      },
      "outputs": [],
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import torch\n",
        "\n",
        "from sklearn.preprocessing import MinMaxScaler\n",
        "from sklearn.metrics import mean_squared_error, mean_absolute_error\n",
        "\n",
        "from torch.utils.data import DataLoader, Dataset\n",
        "from torch import nn"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "014070d7",
      "metadata": {
        "id": "014070d7"
      },
      "source": [
        "----\n",
        "## **CHOOSE MODE & MAIN PARAMETERS**\n",
        "----"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 125,
      "id": "329ef0fc",
      "metadata": {
        "id": "329ef0fc"
      },
      "outputs": [],
      "source": [
        "# Set the notebook mode\n",
        "mode = \"testing\"           # \"training\" OR \"testing\"\n",
        "\n",
        "# checking\n",
        "if mode not in [\"training\", \"testing\"]:\n",
        "    raise ValueError(\"Mode must be set to either 'training' or 'testing'\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 126,
      "id": "712f728e",
      "metadata": {
        "id": "712f728e"
      },
      "outputs": [],
      "source": [
        "# Hyperparameter definition w/o Optuna tuning -- can be added later\n",
        "context  = 96       # [hours]\n",
        "forecast = 96       # [hours]\n",
        "batch    = 64       # [samples]\n",
        "lstm_hidden_layers = 2\n",
        "lstm_hidden_size   = 17\n",
        "optimizer_learningrate = 0.0001\n",
        "epochs = 100"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "0d0750ee",
      "metadata": {
        "id": "0d0750ee"
      },
      "source": [
        "----\n",
        "## **MODEL & CLASS DEFINITION**\n",
        "----"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "69da9a91",
      "metadata": {
        "id": "69da9a91"
      },
      "source": [
        "### **Sample Datasets**\n",
        "\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 127,
      "id": "bacb4fbf",
      "metadata": {
        "id": "bacb4fbf"
      },
      "outputs": [],
      "source": [
        "class Sample_Dataset(Dataset):\n",
        "\n",
        "    def __init__(self, data: pd.DataFrame, context_length: int, forecast_length: int):\n",
        "\n",
        "        # Converting DataFrame to numpy for better processing\n",
        "        self.feature_data    = data.to_numpy(dtype=np.float32)          # input x -- depending on task this is either the whole training, validation or testing split\n",
        "        self.target_data     = data[\"OT\"].to_numpy(dtype=np.float32)    # prediction target y\n",
        "\n",
        "        self.context_length  = context_length       # L [hours]\n",
        "        self.forecast_length = forecast_length      # H [hours]\n",
        "\n",
        "\n",
        "    def __len__(self):\n",
        "        # Total number of samples in the dataset\n",
        "        # S = 1, timestep or stride [hours] -- delta-t by which each sample moves along the time series relative to its predecessor.\n",
        "\n",
        "        sample_qty = (self.feature_data.shape[0] - self.context_length - self.forecast_length) + 1      # = ((T-L-H)/S)+1 | the +1 comes from considering the first sample window before a single stride was made\n",
        "\n",
        "        return sample_qty\n",
        "\n",
        "\n",
        "    def __getitem__(self, sample_index):\n",
        "        # Define what each sample looks like in terms of the data it contains: implement all data that is correlated and shall be fed to the model for learning them\n",
        "        # Every sample is assigned an index, default is integers = 0, 1, 2, 3.... len(dataset)-1\n",
        "\n",
        "        # x = sample input data = the full multivariate time series but restricted to the context length = only ranging from index to (index + context_length) (index = 0,1...!)\n",
        "        x_inputs_array = self.feature_data[sample_index : (sample_index + self.context_length)]           # MIND! last value of that range is EXCLUDED, the first is INCLUDED\n",
        "\n",
        "        # y = data of the correct correlated output that shall be predicted -- here: univariate output of OT from the data, but positioned behind the the training window and being as wide as the forecast window\n",
        "        y_targets_array = self.target_data[(sample_index + self.context_length) : (sample_index + self.context_length + self.forecast_length)]     # MIND! last value of that range is EXCLUDED, the first is INCLUDED\n",
        "\n",
        "        return torch.tensor(x_inputs_array), torch.tensor(y_targets_array)     # convert arrays into tensors for more predictable processing"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "442a40f1",
      "metadata": {
        "id": "442a40f1"
      },
      "source": [
        "### **DataLoader**\n",
        "- using the PyTorch default, no need for custom implementations"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "40d66dea",
      "metadata": {
        "id": "40d66dea"
      },
      "source": [
        "### **Neural Net Design - LSTM**"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 128,
      "id": "0564fe70",
      "metadata": {
        "id": "0564fe70"
      },
      "outputs": [],
      "source": [
        "class LSTM_ForecastModel(nn.Module):\n",
        "\n",
        "    def __init__(self, num_input_features: int, lstm_width: int, lstm_depth: int, forecast_length: int):\n",
        "\n",
        "        self.num_input_features = num_input_features   # multivariate input sequence: channel_number = features processed per timestep\n",
        "        self.lstm_width         = lstm_width           # neurons per layer\n",
        "        self.lstm_depth         = lstm_depth           # number of layers\n",
        "        self.forecast_length    = forecast_length      # [hours] -- can be tuned as hyperparameter\n",
        "\n",
        "        super().__init__()      # initializing the nn.Module parent class also\n",
        "\n",
        "\n",
        "        # LSTM part of the NN\n",
        "        self.lstm_network = nn.LSTM(\n",
        "            input_size   = self.num_input_features,\n",
        "            hidden_size  = self.lstm_width,\n",
        "            num_layers   = self.lstm_depth,\n",
        "            batch_first  = True,                         # batch size = first entry in the DataLoader outputs, typically True\n",
        "            # dropout     = dropout       # 0.2 would mean roughly (20)% of the relevant activations are dropped during each training pass. can help avoid overfitting with large datasets\n",
        "        )\n",
        "\n",
        "        # Linear output layer for direct one-shot multi-timestep forecasting\n",
        "        # --> Use only the output from the last timestep as projection to accumulate info in the LSTM state, discard other outputs --> see forward()\n",
        "        self.output_layer = nn.Linear(\n",
        "            in_features  = self.lstm_width,          # connecting to the last LSTM layer\n",
        "            out_features = self.forecast_length      # projecting to the full forcast window at the same time\n",
        "        )\n",
        "\n",
        "\n",
        "    def forward(self, x_inputs):\n",
        "        # perform the forward pass on itself by feeding inputs x\n",
        "        # tensor from DataLoader: x_inputs.shape = (batch_size, context_length, num_input_features)\n",
        "\n",
        "        lstm_output, _ = self.lstm_network(x_inputs)          # return structure: output, (h_n, c_n) = lstm(x) // output.shape == (batch_size, context_length, hidden_size)\n",
        "\n",
        "        # select the last output for forecasting only, but all related batches and hidden features\n",
        "        lstm_last_output = lstm_output[ : , -1, : ]    # indexation in the tensor: output[batch_index, time_index, hidden_size], starting with 0 -- means [:,context_length -1,:] or just [:,-1,:], remember counting starts with 0 so the last is context -1\n",
        "\n",
        "        # make the forecasting projection with the last lstm outputs to the whole forecast horizon\n",
        "        y_predictions = self.output_layer(lstm_last_output)\n",
        "\n",
        "        return y_predictions     # shape: [batch_size, forecast_length, num_output_features = 1]"
      ]
    },
